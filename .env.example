# ============================================================
# FriendlyBot (Avi) — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real API keys.
#   cp .env.example .env
# ============================================================

# --- LLM Provider Keys ---
OPENROUTER_API_KEY="your-openrouter-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# --- Gemini Vision ---
USE_GEMINI_VISION=true
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_VISION_FALLBACK_MODEL=gemini-2.5-flash-lite

# --- OpenRouter Models (Paid) ---
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_TEXT_FALLBACK_MODEL=meta-llama/llama-4-maverick
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_FALLBACK_MODEL=anthropic/claude-sonnet-4

# --- OpenRouter Timeouts ---
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_PRIMARY_TIMEOUT_SECONDS=6

# --- OpenRouter App Identity ---
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=FriendlyBot

# --- Feature Flags ---
ALLOW_SAMPLE_INVOICES=true
ENABLE_MCP_ORCHESTRATOR=true

# --- RAG Settings ---
ENABLE_RAG=true
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
